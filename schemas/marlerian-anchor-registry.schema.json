{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RJMpgh/vector-tongue/schemas/marlerian-anchor-registry.schema.json",
  "title": "Marlerian Anchor Registry",
  "type": "object",
  "required": ["registry_id","version","status","language","description","governance","anchors"],
  "properties": {
    "registry_id": {"type":"string"},
    "version": {"type":"string"},
    "status": {"enum":["illustrative-draft","candidate","stable","deprecated"]},
    "language": {"type":"string"},
    "description": {"type":"string"},
    "governance": {"type":"object","required":["steward","principles","change_policy"]},
    "anchors": {"type":"array","minItems":1}
  }
}
