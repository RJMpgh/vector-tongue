# Vector Tongue Environment Variables
PORT=3000
NODE_ENV=development

# Server-side provider credentials only. Never expose these in browser code.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Comma-separated allowed browser origins. Empty in local development allows all origins.
# Example production value:
# CORS_ORIGIN=https://vector-tongue.example.com
CORS_ORIGIN=
